{
  "name": "kimi-search-mcp",
  "version": "1.1.0",
  "description": "Local MCP server for Kimi web search",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prepack": "npm run build"
  },
  "bin": {
    "kimi-search-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "kimi",
    "moonshot",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "web-search",
    "search",
    "web-fetch"
  ],
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "author": "Caelix",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaelixOrbit/kimi-search-mcp.git"
  },
  "homepage": "https://github.com/CaelixOrbit/kimi-search-mcp#readme",
  "bugs": {
    "url": "https://github.com/CaelixOrbit/kimi-search-mcp/issues"
  }
}
